{
  "name": "chatterbox2",
  "version": "0.0.0",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "npx esbuild src/functions/*.ts --bundle --platform=node --target=node24 --outdir=dist/functions --external:@twilio-labs/serverless-runtime-types",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "jest",
    "prestart": "npm run lint && npm run build",
    "start": "twilio-run --functions-folder dist/functions",
    "predeploy": "npm run lint && npm test && npm run build",
    "deploy": "npx dotenv-cli -- twilio-run deploy --service-name ${SERVICE_NAME:-chatterbox2} --functions-folder dist/functions --runtime node24 --override-existing-project",
    "promote": "twilio-run promote --to= --from=dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@twilio-labs/serverless-runtime-types": "^4.0.1",
    "@twilio/runtime-handler": "2.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "twilio-run": "^5.0.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "chokidar": "^4.0.0",
    "execa": "5.1.1",
    "file-type": "22.0.1",
    "js-yaml": "^4.1.0",
    "qs": "^6.15.4"
  },
  "engines": {
    "node": "24"
  }
}
